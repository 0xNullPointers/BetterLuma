# BetterLuma.toml - BetterLumaCore configuration
# Place this file in your Steam installation directory (next to steam.exe).
# Rename to BetterLuma.toml to activate. All sections are optional - missing
# keys fall back to the defaults shown below.

[log]
# Log level: "debug", "info", "warn", "error"
level = "debug"
# Extra verbose logging in debug builds
verbose = true

[lua]
# Extra directories to watch for .lua files (beyond config/stplug-in/)
paths = []

[manifest_fetch]
# URL chain for depot manifest downloads, tried in order until one returns 200.
# {gid} is replaced with the manifest GID at request time.
# The first built-in provider needs a compatibility User-Agent; BetterLuma adds it internally.
urls = [
    "https://manifest.opensteamtool.com/{gid}",
    "https://manifest.steam.run/api/manifest/{gid}",
    "http://gmrc.wudrm.com/manifest/{gid}",
]
# Max seconds to wait per provider before trying the next one
timeout_sec = 12
# Trusted host allowlist - responses from other hosts are rejected
trusted_hosts = [
    "manifest.opensteamtool.com",
    "manifest.steam.run",
    "gmrc.wudrm.com",
]

[pattern_fetch]
# Remote pattern & IPC TOML fetcher URL template.
# Placeholders:
#   {channel}   - Repository channel/branch (e.g. "pattern")
#   {component} - Component name (e.g. "steamclient", "steamui", "steamclientipc")
#   {subdir}    - Component subdirectory ("steamclient", "steamui", "steamclientipc")
#   {sha256}    - Lowercase 64-character SHA-256 hash of target DLL
#   {sha}       - Same as {sha256}
# NOTE: BetterLuma does NOT provide any default remote pattern links.
# If url_template / mirror is empty or omitted, remote network fetching is skipped
# and BetterLuma operates strictly in cache-only mode.
# Can also be specified as url_template under [pattern_fetch] or [remote] (OpenSteamTool format).
# Example:
# url_template = "https://raw.githubusercontent.com/user/patterns/{channel}/{component}/{sha256}.toml"
url_template = ""

[stats]
# Enable stats and achievement API
enable_api = true

[process_extension]
# Inject an extension DLL into game processes at launch
enabled = false
# Path to 32-bit extension DLL
x86 = ""
# Path to 64-bit extension DLL
x64 = ""

[onlinefix]
# Inject BetterLumaPayload.dll into online-fix game processes for EOS bridge
inject_enabled = true

[boot]
# Show a diagnostic popup with Steam build ID and steamclient SHA256 when
# patterns can't load (new Steam build, network down, GitHub cache miss).
# The popup data is what you need to report a missing build.
diagnostic_popup = true

[steamstub]
# Automatically activate the SteamStub bypass route when launching a
# Lua-tracked game that has SteamStub protection, is not owned, and
# has no manual stub flag set. Set to false to disable automatic bypass
# (manual flag override in the Lua pattern still works).
auto_enabled = false

[cloud]
# Optional Steam Cloud save redirection for unlocked ("lua") games, powered by
# CloudRedirect (https://github.com/Selectively11/CloudRedirect).
#
# When enabled = true:
#   BetterLuma loads cloud_redirect.dll inside Steam, registers every addappid() game
#   as a redirected app, and routes their Steam Cloud RPCs through CloudRedirect's
#   cloud-save engine.
#   Provider sign-in (Google Drive / OneDrive / local folder) is still done through
#   CloudRedirect's companion app — BetterLuma only hosts the DLL.
#   Note: When enabled = true, the suppressed setting is ignored and CloudRedirect
#   manages cloud saves directly.
#
# When enabled = false:
#   CloudRedirect is disabled.
#   - If suppressed = true (default):
#     BetterLuma disables Steam Cloud for Lua-unlocked games and suppresses the
#     "Cloud Sync Failed" error dialog and warning notifications.
#   - If suppressed = false:
#     BetterLuma ignores suppression logic and lets native Steam handle cloud save
#     checks normally without blocking or faking sync state.
enabled = false
suppressed = true

# Path to cloud_redirect.dll. Absolute, or relative to the Steam root directory.
# Defaults to "<Steam>/cloud_redirect.dll" when unset.
library = "cloud_redirect.dll"
